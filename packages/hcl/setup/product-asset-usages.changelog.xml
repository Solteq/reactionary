<?xml version="1.0" encoding="UTF-8"?>
<!--
  Attachment relation usages for the Reactionary productAssets capability.

  Creates one usage per product asset type in ATCHRLUS (identifier + sequence) and its English description in
  ATCHRLUSDS (LANGUAGE_ID -1). Fixed ids from 72000000, so the script gives the same ids in every environment.

  Idempotent: each changeSet is marked as ran, not failed, when the usage identifier or either id already exists.
  Add descriptions in other languages as further ATCHRLUSDS rows (see README.md).
-->
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- MANUAL -> asset type "manual" -->
    <changeSet id="reactionary-product-asset-usage-manual" author="reactionary">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM ATCHRLUS WHERE IDENTIFIER = 'MANUAL' OR ATCHRLUS_ID = 72000000</sqlCheck>
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM ATCHRLUSDS WHERE ATCHRLUSDS_ID = 72000000</sqlCheck>
        </preConditions>
        <insert tableName="ATCHRLUS">
            <column name="ATCHRLUS_ID" valueNumeric="72000000"/>
            <column name="IDENTIFIER" value="MANUAL"/>
            <column name="SEQUENCE" valueNumeric="1"/>
        </insert>
        <insert tableName="ATCHRLUSDS">
            <column name="ATCHRLUSDS_ID" valueNumeric="72000000"/>
            <column name="ATCHRLUS_ID" valueNumeric="72000000"/>
            <column name="LANGUAGE_ID" valueNumeric="-1"/>
            <column name="NAME" value="Manual"/>
            <column name="SHORTDESCRIPTION" value="Product manual"/>
        </insert>
        <rollback>
            <delete tableName="ATCHRLUSDS"><where>ATCHRLUSDS_ID = 72000000</where></delete>
            <delete tableName="ATCHRLUS"><where>ATCHRLUS_ID = 72000000</where></delete>
        </rollback>
    </changeSet>

